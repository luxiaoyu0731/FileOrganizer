{
  "name": "file-organizer",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .",
    "build": "npm run build:frontend && npm run build:electron && electron-builder --config config/electron-builder.yml --publish never",
    "build:frontend": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:backend": "bash scripts/build-backend.sh",
    "build:mac": "npm run build:frontend && npm run build:electron && electron-builder --config config/electron-builder.yml --mac --arm64 --publish never",
    "build:win": "npm run build:frontend && npm run build:electron && electron-builder --config config/electron-builder.yml --win --publish never",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "build:mac:signed": "node scripts/check-signing.cjs && npm run build:mac"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.0.3",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
